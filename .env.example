# Copiá este archivo como .env (solo para pruebas locales) y completá los valores.
# En el hosting (Render/Railway) se cargan en su panel de "Environment". Nunca subas el .env a GitHub.

# URL pública del backend nuevo, sin barra final. Ej: https://precioml-backend.onrender.com
PUBLIC_URL=

# Base de datos Upstash Redis (console.upstash.com -> tu base -> REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Emails (resend.com -> API Keys)
RESEND_API_KEY=

# MercadoPago (credenciales de producción -> Access Token)
MP_ACCESS_TOKEN=

# Secretos propios: inventá dos claves largas y distintas
CRON_SECRET=
ADMIN_SECRET=

# Opcionales (solo si todavía usás la integración con la API de MercadoLibre)
ML_CLIENT_ID=
ML_CLIENT_SECRET=
